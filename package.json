{
  "name": "busola-server",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "clear & bun run src/index.ts",
    "start": "bun --hot run src/index.ts",
    "prisma:pull": "bun prisma db pull",
    "prisma:migrate": "bun prisma migrate dev",
    "prisma:format": "bun prisma format",
    "prisma:generate": "bun prisma generate",
    "prisma:schema": "bun run prisma:format && bun run prisma:migrate && bun run prisma:generate",
    "prepare": "husky",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.mts,.cts",
    "format": "prettier . --check"
  },
  "lint-staged": {
    "src/**/!(generated)/**/*.{ts,mts,cts}": [
      "prettier --write --ignore-unknown",
      "eslint --fix --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.4.1",
    "@fastify/swagger-ui": "^5.0.1",
    "@prisma/client": "^6.12.0",
    "@supabase/supabase-js": "^2.52.1",
    "@types/bcrypt": "^6.0.0",
    "@types/lodash": "^4.17.20",
    "bcrypt": "^6.0.0",
    "contentful": "^11.7.15",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "prisma": "^6.12.0",
    "resend": "^4.7.0",
    "zod": "^4.0.10"
  }
}
