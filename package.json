{
  "name": "busola-server",
  "module": "index.ts",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run prisma:generate && tsc -p tsconfig.json && cp -r src/generated dist/",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:schema": "npm run prisma:format && npm run prisma:migrate && npm run prisma:generate",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts,.mts,.cts",
    "format": "prettier . --check",
    "lint-staged": "lint-staged",
    "test": "vitest --passWithNoTests --watch=false",
    "test:watch": "vitest --watch --passWithNoTests"
  },
  "lint-staged": {
    "src/**/!(generated)/**/*.{ts,mts,cts}": [
      "prettier --write --ignore-unknown",
      "eslint --fix --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.4.1",
    "@fastify/swagger-ui": "^5.0.1",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.12.0",
    "@supabase/supabase-js": "^2.52.1",
    "@types/bcrypt": "^6.0.0",
    "@types/lodash": "^4.17.20",
    "bcrypt": "^6.0.0",
    "contentful": "^11.7.15",
    "dotenv": "^17.2.2",
    "fastify": "^5.4.0",
    "prisma": "^6.12.0",
    "resend": "^4.7.0",
    "zod": "^4.0.10"
  }
}
